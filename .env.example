# Cognitive-Fabric Configuration

# Logging
COGNITIVE_FABRIC_LOG_LEVEL=INFO
COGNITIVE_FABRIC_LOG_JSON=true

# Database (optional override)
# COGNITIVE_FABRIC_DB_PATH_OVERRIDE=/path/to/custom/db

# LLM Provider (openai or anthropic)
COGNITIVE_FABRIC_LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
COGNITIVE_FABRIC_OPENAI_MODEL=gpt-4o

# Anthropic Configuration (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# COGNITIVE_FABRIC_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Memory Optimizer
COGNITIVE_FABRIC_OPTIMIZER_DEFAULT_STRATEGY=conservative
COGNITIVE_FABRIC_OPTIMIZER_ENABLE_MCP_SAMPLING=true
COGNITIVE_FABRIC_OPTIMIZER_SNAPSHOT_FAILURE_POLICY=warn

# Cognitive Fabric (semantic layer)
# Where the LanceDB vector store is stored (defaults to ./.fabric_data)
# COGNITIVE_FABRIC_FABRIC_DATA_DIR=/path/to/fabric_data
# Embedding backend: sentence-transformers (local, default) or openai
COGNITIVE_FABRIC_FABRIC_EMBEDDING_PROVIDER=sentence-transformers
# COGNITIVE_FABRIC_FABRIC_EMBEDDING_MODEL=all-MiniLM-L6-v2
