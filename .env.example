# Cognitive-Fabric Configuration
#
# Every model id in this file is an example. No model is compiled into the
# package: a model id is a vendor, a price and a capability envelope chosen at
# install time, and it goes stale only when the provider retires the name. A
# provider is usable once you name a model for it, and the server says which
# setting is missing when you have not.

# Logging
COGNITIVE_FABRIC_LOG_LEVEL=INFO
COGNITIVE_FABRIC_LOG_JSON=true

# Database (required: the server has no default path)
# COGNITIVE_FABRIC_DB_PATH=/path/to/custom/db

# LLM Provider (openai or anthropic)
COGNITIVE_FABRIC_LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
# Required. Must be a model the provider still lists -- it is checked against
# https://api.openai.com/v1/models before the first call.
COGNITIVE_FABRIC_OPENAI_MODEL=<a model id from https://platform.openai.com/docs/models>

# Anthropic Configuration (alternative)
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# COGNITIVE_FABRIC_ANTHROPIC_MODEL=<a model id from https://docs.anthropic.com/en/docs/about-claude/models>

# Embeddings for the semantic layer. There is no default cloud embedding model:
# an embedding model fixes both the price per million tokens and the width of
# every vector already in the table, and vectors from two models are not
# comparable. The local backends keep their own defaults.
#
#   fastembed              local, ONNX, no torch   (default)
#   sentence-transformers  local, needs torch
#   openai                 cloud, model required
# COGNITIVE_FABRIC_FABRIC_EMBEDDING_PROVIDER=fastembed
# COGNITIVE_FABRIC_FABRIC_EMBEDDING_MODEL=<required when the provider is openai>

# Memory Optimizer
COGNITIVE_FABRIC_OPTIMIZER_DEFAULT_STRATEGY=conservative
COGNITIVE_FABRIC_OPTIMIZER_ENABLE_MCP_SAMPLING=true
COGNITIVE_FABRIC_OPTIMIZER_SNAPSHOT_FAILURE_POLICY=warn

# Cognitive Fabric (semantic layer)
# Where the LanceDB vector store is stored (defaults to ./.fabric_data)
# COGNITIVE_FABRIC_FABRIC_DATA_DIR=/path/to/fabric_data
